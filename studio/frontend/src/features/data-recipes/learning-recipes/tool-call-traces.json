{
  "recipe": {
    "model_providers": [
      {
        "name": "openai-compatible",
        "endpoint": "",
        "provider_type": "openai",
        "extra_headers": {},
        "extra_body": {}
      }
    ],
    "mcp_providers": [],
    "model_configs": [
      {
        "alias": "teacher-model",
        "model": "",
        "provider": "openai-compatible",
        "inference_parameters": {
          "temperature": 0.7
        }
      }
    ],
    "tool_configs": [],
    "columns": [
      {
        "column_type": "sampler",
        "name": "domain",
        "drop": false,
        "sampler_type": "category",
        "params": {
          "values": [
            "payments",
            "weather",
            "project tracking",
            "ticketing"
          ]
        }
      },
      {
        "column_type": "llm-structured",
        "name": "tool_schema",
        "drop": false,
        "model_alias": "teacher-model",
        "prompt": "Design ONE tool for the {{ domain }} domain as an OpenAI function schema.\n\nRules:\n- 2 to 4 parameters, each typed and described\n- at least one enum or bounded number\n- at least one optional parameter with a default behaviour\n\nReturn the schema object only.",
        "with_trace": "none",
        "extract_reasoning_content": false,
        "output_format": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "parameters": {
              "type": "object"
            }
          },
          "required": [
            "name",
            "description",
            "parameters"
          ],
          "additionalProperties": false
        },
        "system_prompt": "You design narrow, well-typed tools. No kitchen-sink parameters."
      },
      {
        "column_type": "llm-text",
        "name": "user_request",
        "drop": false,
        "model_alias": "teacher-model",
        "prompt": "Tool:\n{{ tool_schema }}\n\nWrite ONE natural request a user would make that requires this tool, and contains every argument value needed to call it. Do not name the tool or mention JSON.\n\nReturn only the request.",
        "with_trace": "none",
        "extract_reasoning_content": false,
        "system_prompt": "You write the user side of a function call, with all values embedded."
      },
      {
        "column_type": "llm-structured",
        "name": "tool_call",
        "drop": false,
        "model_alias": "teacher-model",
        "prompt": "Tool:\n{{ tool_schema }}\n\nUser request:\n{{ user_request }}\n\nReturn the single call this request needs. Use only parameters the schema declares, and copy values from the request instead of inventing them.",
        "with_trace": "none",
        "extract_reasoning_content": false,
        "output_format": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "arguments": {
              "type": "object"
            },
            "rationale": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "arguments"
          ],
          "additionalProperties": false
        },
        "system_prompt": "You emit exactly one function call. Arguments must be schema-valid."
      },
      {
        "column_type": "llm-judge",
        "name": "call_judge",
        "drop": false,
        "model_alias": "teacher-model",
        "prompt": "Tool:\n{{ tool_schema }}\n\nRequest:\n{{ user_request }}\n\nCall:\n{{ tool_call }}",
        "with_trace": "none",
        "extract_reasoning_content": false,
        "scores": [
          {
            "name": "SchemaValid",
            "description": "The call obeys the schema and its parameter types",
            "options": {
              "0": "wrong shape",
              "1": "unknown parameter",
              "2": "valid",
              "3": "valid and minimal"
            }
          },
          {
            "name": "Grounded",
            "description": "Argument values come from the request, not from imagination",
            "options": {
              "0": "invented values",
              "1": "some invented",
              "2": "mostly grounded",
              "3": "every value traceable"
            }
          }
        ],
        "system_prompt": "You grade function calls. Invented argument values are the main failure."
      }
    ],
    "processors": []
  },
  "run": {
    "rows": 5,
    "preview": true,
    "output_formats": [
      "jsonl"
    ]
  },
  "ui": {
    "nodes": [
      {
        "id": "domain",
        "x": 120,
        "y": 620,
