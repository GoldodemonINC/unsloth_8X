        "type": "canvas",
        "source_handle": "data-out",
        "target_handle": "data-in"
      },
      {
        "from": "reasoning",
        "to": "final_answer",
        "type": "canvas",
        "source_handle": "data-out",
        "target_handle": "data-in"
      },
      {
        "from": "final_answer",
        "to": "response",
        "type": "canvas",
        "source_handle": "data-out",
        "target_handle": "data-in"
      },
      {
        "from": "response",
        "to": "reasoning_judge",
        "type": "canvas",
        "source_handle": "data-out",
        "target_handle": "data-in"
      }
    ],
    "layout_direction": "LR"
  }
}
